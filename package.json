{
  "name": "mission-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "format": "prettier --write src server scripts index.html vite.config.ts tsconfig*.json package.json",
    "format:check": "prettier --check src server scripts index.html vite.config.ts tsconfig*.json package.json",
    "preview": "vite preview --host 127.0.0.1",
    "serve:lan": "node server/lan-server.ts",
    "start:lan": "npm run build && npm run serve:lan",
    "export:board": "node scripts/export-board.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
